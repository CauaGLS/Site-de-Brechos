# Copy this file to backend/.env and fill in real values for local
# development. In production (Render) these are set as environment
# variables in the dashboard / render.yaml instead of a committed .env file.

# --- Django core ---
# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me-to-a-random-secret-key
DEBUG=True
# Comma-separated list of allowed hosts, e.g. localhost,127.0.0.1,my-api.onrender.com
ALLOWED_HOSTS=*

# --- CORS / CSRF ---
# Keep True for local dev; set to False in production and list the exact
# frontend origin(s) below instead.
CORS_ALLOW_ALL_ORIGINS=True
# Comma-separated list of allowed frontend origins (no trailing slash),
# e.g. https://your-frontend.vercel.app
CORS_ALLOWED_ORIGINS=
# Comma-separated list of trusted origins for CSRF (needed for /admin),
# e.g. https://your-frontend.vercel.app,https://your-api.onrender.com
CSRF_TRUSTED_ORIGINS=

# --- Database ---
# Either set DATABASE_URL directly (used as-is, e.g. what Render injects)...
# DATABASE_URL=postgres://user:password@host:5432/dbname
# ...or set the discrete POSTGRES_* vars below (used to build DATABASE_URL
# when DATABASE_URL itself isn't set) — this matches docker-compose.yml.
POSTGRES_DB=aodesapego
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Set to True when connecting to a managed Postgres that requires SSL
# (e.g. Render's Postgres from outside its private network).
DATABASE_SSL_REQUIRE=False

# --- Misc ---
TIME_ZONE=America/Sao_Paulo
