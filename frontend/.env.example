# Copy this file to frontend/.env.local (or frontend/.env) and fill in real
# values for local development. In production (Vercel) these are set as
# Environment Variables in the project settings instead.

# --- Backend API ---
# Base URL of the Django backend (no trailing slash), used server-side by
# the proxy route at app/api/[[...proxy]]/route.ts, which forwards every
# /api/* request (except /api/auth/*) to `${SERVER_URL}${path}` together
# with the current better-auth session token as a Bearer token.
# Local dev: http://localhost:8000
# Production (Render): https://your-backend.onrender.com
SERVER_URL=http://localhost:8000

# --- better-auth ---
# Secret used to sign/encrypt sessions and tokens. Generate one with:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-random-secret
# Public URL of this Next.js app itself (used by better-auth for callback
# URLs, etc.). Local dev: http://localhost:3000
# Production (Vercel): https://your-app.vercel.app
BETTER_AUTH_URL=http://localhost:3000

# --- Google OAuth (better-auth social provider) ---
# From Google Cloud Console > APIs & Services > Credentials.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Database (better-auth's own Postgres connection) ---
# Same Postgres instance/database used by the Django backend (see
# backend/.env.example) — better-auth reads/writes the users, sessions,
# accounts and verifications tables directly.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=aodesapego
